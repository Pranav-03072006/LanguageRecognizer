# ==========================================
# PolyGlot AI - Environment Configuration
# ==========================================

# Django Settings
SECRET_KEY=django-insecure-replace-this-with-a-secure-random-key-in-production
DEBUG=True
ALLOWED_HOSTS=*

# ML Model Configuration (relative to project root or absolute)
MODEL_ARTIFACT_PATH=artifacts/language_recognizer.joblib

# Direct LLM SDK Configuration (No LangChain, No RAG)
# Options for LLM_PROVIDER: gemini, openai
LLM_PROVIDER=gemini

# API Key for the chosen provider (leave empty for offline rule/template fallback)
LLM_API_KEY=

# Model identifier for the provider:
# For Gemini: gemini-2.5-flash, gemini-1.5-pro, gemini-1.5-flash
# For OpenAI: gpt-4o-mini, gpt-4o, gpt-3.5-turbo
LLM_MODEL=gemini-2.5-flash
